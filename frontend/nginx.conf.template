server {
    listen 80;
    resolver 127.0.0.11 valid=5s;
    set $backend http://${BACKEND_HOST}:${BACKEND_PORT};

    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
